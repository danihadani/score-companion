# Copy this file to ".env.test" - the tests read it.
# Same user and password as .env, but a separate database, so the
# tests can empty its tables without touching your real projects.
DATABASE_URL="postgresql://score:change-me@localhost:5432/score_companion_test"

# Signs the login tokens. Any long random text; keep it secret.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"