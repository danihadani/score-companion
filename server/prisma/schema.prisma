generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- a composer who logs in ----------

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  fullName  String
  email     String
  // A bcrypt hash, never the password itself
  password  String
  createdAt DateTime @default(now())

  projects Project[]
}

// ---------- a film project ----------

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  director  String?
  fps       Float
  createdAt DateTime @default(now())

  cues Cue[]
    // Optional only so projects made before users existed can stay in the database.
  // New projects always get the composer who created them.
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cue {
  id          Int      @id @default(autoincrement())
  name        String
  timecodeIn  String
  timecodeOut String
  scene       String?
  status      String   @default("sketch")
  createdAt   DateTime @default(now())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tempTracks TempTrack[]
  checklist  ChecklistItem[]
  notes      Note[]
}

// ---------- a reference track the director liked for a cue ----------

model TempTrack {
  id         Int      @id @default(autoincrement())
  title      String
  artist     String?
  link       String?
  notes      String?
  previewUrl String?
  artworkUrl String?
  createdAt  DateTime @default(now())

  cueId Int
  cue   Cue @relation(fields: [cueId], references: [id], onDelete: Cascade)
  
}

// ---------- one thing a cue still needs, e.g. "Orchestration" ----------

model ChecklistItem {
  id        Int      @id @default(autoincrement())
  label     String
  done      Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  cueId Int
  cue   Cue @relation(fields: [cueId], references: [id], onDelete: Cascade)
}

// ---------- a dated note on a cue: what changed, and why ----------

model Note {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  cueId Int
  cue   Cue @relation(fields: [cueId], references: [id], onDelete: Cascade)
}