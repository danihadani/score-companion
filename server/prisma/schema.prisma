generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- a film project ----------

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  director  String?
  fps       Float
  createdAt DateTime @default(now())

  cues Cue[]
}

model Cue {
  id          Int      @id @default(autoincrement())
  name        String
  timecodeIn  String
  timecodeOut String
  scene       String?
  status      String   @default("sketch")
  createdAt   DateTime @default(now())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tempTracks TempTrack[]
}

// ---------- a reference track the director liked for a cue ----------

model TempTrack {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String?
  link      String?
  notes     String?
  createdAt DateTime @default(now())

  cueId Int
  cue   Cue @relation(fields: [cueId], references: [id], onDelete: Cascade)
}
